# hybrid: live Sandbox calls when credentials are set, otherwise deterministic replay vault
PAYPAL_MODE=hybrid
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PACTPAL_MANDATE_SECRET=
# Claude buyer/seller negotiation agents (claude-opus-5-5). Without it the scripted negotiation runs.
ANTHROPIC_API_KEY=
# NVIDIA API catalog (OpenAI-compatible). Used when no ANTHROPIC_API_KEY is set; PACTPAL_AI=anthropic|nvidia|off forces one.
NVIDIA_API_KEY=
# PACTPAL_NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# PACTPAL_NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
